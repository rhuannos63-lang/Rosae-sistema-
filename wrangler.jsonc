// Publicação na Cloudflare (Workers com arquivos estáticos). Grátis.
// O Cloudflare roda "npm run build" e publica a pasta dist.
{
  "name": "rosae-sistema",
  "compatibility_date": "2026-10-01",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
